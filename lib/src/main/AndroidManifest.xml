<?xml version="1.0" encoding="utf-8"?>
<!-- The library contributes the accessibility service, the in-app command
     receiver and the boot recorder, so a consumer only declares its own app.
     The allowlist itself is vendor-gated: this library drives the screen, it
     never writes com.freeme.freemanager's list. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name=".AutostartService"
            android:exported="true"
            android:label="@string/autostart_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility" />
        </service>

        <receiver
            android:name=".AutostartCommand"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.mbanucu.blackviewautostart.TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- Protected system broadcasts: another app cannot send them. The
             receiver is directBootAware because this is the signal that has to
             arrive before the first unlock. -->
        <receiver
            android:name=".BootStart$Recorder"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
